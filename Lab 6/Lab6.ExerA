<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rock, Paper, Scissors</title>
  <!-- External stylesheet -->
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- Header section -->
  <header>
    <h1>Rock, Paper, Scissors</h1>
    <p>Enter your name, click Start Game, then choose Rock, Paper or Scissors.</p>
  </header>

  <!-- Player setup section -->
  <section class="player">
    <label for="playerName">Your name:</label>
    <input type="text" id="playerName" placeholder="Enter your name">
    <button type="button" onclick="startGame()">Start Game</button>
    <p id="welcomeMsg"></p>
  </section>

  <!-- Game controls and choice images section -->
  <section class="game">
    <div class="choices">
      <button type="button" onclick="playRound('rock')">Rock</button>
      <button type="button" onclick="playRound('paper')">Paper</button>
      <button type="button" onclick="playRound('scissors')">Scissors</button>
    </div>
    
    <div class="arena">
      <div class="playerBox">
        <p><strong>You</strong></p>
        <img id="playerImg" src="rock.png" alt="Your choice">
      </div>
      <div class="vs-label">VS</div>
      <div class="computerBox">
        <p><strong>Computer</strong></p>
        <img id="computerImg" src="rock.png" alt="Computer choice">
      </div>
    </div>
  </section>

  <!-- Result and scoreboard section -->
  <section class="status">
    <p id="result"></p>
    <p class="scoreboard">
      Wins: <span id="wins">0</span> &nbsp;
      Losses: <span id="losses">0</span> &nbsp;
      Draws: <span id="draws">0</span>
    </p>
  </section>

  <!-- Round history and action buttons -->
  <section class="history">
    <h2>History</h2>
    <table id="history">
      <thead>
        <tr>
          <th>Round</th>
          <th>You</th>
          <th>Computer</th>
          <th>Result</th>
        </tr>
      </thead>
      <tbody id="historyBody"></tbody>
    </table>

    <div class="controls">
      <button type="button" onclick="showSummary()">Show Summary</button>
      <button type="button" onclick="resetGame()">Reset</button>
    </div>
    <p id="summary"></p>
  </section>

  <!-- Footer section -->
  <footer>
    <p id="startTime"></p>
    <p>&copy; 2026 Computer Science Club</p>
  </footer>

  <!-- External JavaScript file -->
  <script src="game.js"></script>
</body>
</html>
